name = "robert-tobis-aesthetik"
main = "dist/server/index.js"
compatibility_date = "2026-10-01"
workers_dev = true

[vars]
CONTACT_RECIPIENT = "replace-with-recipient@example.com"
BREVO_SENDER_EMAIL = "replace-with-verified-sender@example.com"

[[d1_databases]]
binding = "DB"
database_name = "robert-tobis-aesthetik"
database_id = "REPLACE_WITH_D1_DATABASE_ID"
